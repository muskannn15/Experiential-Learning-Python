import time

start_time = 0
stop_time = 0

print("SIMPLE STOPWATCH")

while True:
    print("\n1. Start")
    print("2. Stop")
    print("3. Display")
    print("4. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        start_time = time.time()
        print("Stopwatch started.")

    elif choice == "2":
        stop_time = time.time()
        print("Stopwatch stopped.")

    elif choice == "3":
        if start_time != 0 and stop_time != 0:
            elapsed = stop_time - start_time
            print("Elapsed Time:", round(elapsed, 2), "seconds")
        else:
            print("No time recorded.")

    elif choice == "4":
        print("Exiting...")
        break

    else:
        print("Invalid choice.")
