import time

start_time = None
elapsed_time = 0
running = False

while True:
    print("\n===== SIMPLE STOPWATCH =====")
    print("1. Start")
    print("2. Stop")
    print("3. Display")
    print("4. Reset")
    print("5. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        if running:
            print("Stopwatch is already running!")
        else:
            start_time = time.time()
            running = True
            print("Stopwatch started.")

    elif choice == "2":
        if not running:
            print("Stopwatch has not been started!")
        else:
            elapsed_time += time.time() - start_time
            running = False
            print(f"Stopped: {elapsed_time:.2f} seconds")

    elif choice == "3":
        if running:
            current = elapsed_time + (time.time() - start_time)
        else:
            current = elapsed_time

        print(f"Elapsed Time: {current:.2f} seconds")

    elif choice == "4":
        start_time = None
        elapsed_time = 0
        running = False
        print("Stopwatch reset.")

    elif choice == "5":
        print("Thank you!")
        break

    else:
        print("Invalid choice!")
