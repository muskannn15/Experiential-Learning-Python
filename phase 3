import time

start_time = None
elapsed_time = 0
lap_number = 0


def display_time(seconds):
    hours = int(seconds // 3600)
    minutes = int((seconds % 3600) // 60)
    secs = seconds % 60

    print(f"Elapsed Time: {hours:02d}:{minutes:02d}:{secs:05.2f}")


while True:
    print("\n===== SIMPLE STOPWATCH =====")
    print("1. Start")
    print("2. Stop")
    print("3. Reset")
    print("4. Display Elapsed Time")
    print("5. Lap Time")
    print("6. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        if start_time is None:
            start_time = time.perf_counter()
            print("Stopwatch started successfully!")
        else:
            print("Error: Stopwatch is already running.")

    elif choice == "2":
        if start_time is not None:
            elapsed_time += time.perf_counter() - start_time
            start_time = None

            print("Stopwatch stopped.")
            display_time(elapsed_time)
        else:
            print("Error: Stopwatch is not running.")

    elif choice == "3":
        start_time = None
        elapsed_time = 0
        lap_number = 0

        print("Stopwatch reset successfully!")

    elif choice == "4":
        current_time = elapsed_time

        if start_time is not None:
            current_time += time.perf_counter() - start_time

        display_time(current_time)

    elif choice == "5":
        current_time = elapsed_time

        if start_time is not None:
            current_time += time.perf_counter() - start_time

            lap_number += 1

            print(f"Lap {lap_number}:")
            display_time(current_time)

        else:
            print("Error: Start the stopwatch before recording a lap.")

    elif choice == "6":
        print("Thank you for using the stopwatch!")
        break

    else:
        print("Invalid choice! Please enter a number between 1 and 6.")
