import time

start_time = None
elapsed_time = 0

while True:
    print("\n--- SIMPLE STOPWATCH ---")
    print("1. Start")
    print("2. Stop")
    print("3. Reset")
    print("4. Display")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        if start_time is None:
            start_time = time.time()
            print("Stopwatch started.")
        else:
            print("Stopwatch is already running.")

    elif choice == "2":
        if start_time is None:
            print("Error: Start the stopwatch first.")
        else:
            elapsed_time += time.time() - start_time
            start_time = None
            print("Stopwatch stopped.")

    elif choice == "3":
        start_time = None
        elapsed_time = 0
        print("Stopwatch reset.")

    elif choice == "4":
        current_time = elapsed_time

        if start_time is not None:
            current_time += time.time() - start_time

        print("Elapsed Time:", round(current_time, 2), "seconds")

    elif choice == "5":
        print("Exiting Stopwatch.")
        break

    else:
        print("Invalid choice.")
